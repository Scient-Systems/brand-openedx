{
  "$type": "color",
  "color": {
    "light": {
      "base": {
        "$value": "#26345E",
        "source": "$primary",
        "actions": {
          "default": "{color.light.base}"
        },
        "$description": "Basic light color, dark theme."
      },
      "700": {
        "source": "$light-700",
        "actions": {
          "default": "{color.light.700}"
        },
        "$value": "{color.primary.700}",
        "$description": "Light color of level 700."
      }
    },
    "primary": {
      "100": {
        "source": "$primary-100",
        "actions": {
          "default": "{color.primary.100}"
        },
        "$value": "#BCABFF",
        "$description": "Primary color of level 100."
      },
      "500": {
        "source": "$primary-500",
        "actions": {
          "default": "{color.primary.500}"
        },
        "$value": "#3D5586",
        "$description": "Primary color of level 500."
      },
      "base": {
        "$value": "#9F8BFF",
        "source": "$primary",
        "actions": {
          "default": "{color.primary.base}"
        },
        "$description": "Basic primary color, dark theme."
      },
      "700": {
        "source": "$primary-700",
        "actions": {
          "default": "{color.primary.700}"
        },
        "$value": "#2A3A69",
        "$description": "Primary color of level 700."
      },
      "light": {
        "$value": "#18254A",
        "source": "$primary-light",
        "actions": {
          "default": "{color.primary.light}"
        },
        "$description": "Light primary color, dark theme."
      },
      "border": {
        "$value": "#26345E",
        "source": "$primary-border",
        "actions": {
          "default": "{color.primary.border}"
        },
        "$description": "Primary border color, dark theme."
      }
    },
    "brand": {
      "base": {
        "$value": "#A9BC3F",
        "source": "$brand",
        "actions": {
          "default": "{color.brand.base}"
        },
        "$description": "Brand color, dark theme — Meridian ember CTAs on night (ink text)."
      }
    },
    "text": {
      "base": {
        "$value": "#E9EEFA",
        "source": "$text-color",
        "actions": {
          "default": "{color.text.base}"
        },
        "$description": "Text base color, dark theme."
      },
      "footer": {
        "$value": "{color.text.primary}",
        "source": "$footer-color",
        "actions": {
          "default": "{color.text.footer}"
        },
        "$description": "Footer text color, dark theme."
      },
      "primary": {
        "$value": "#C2CDE8",
        "source": "$text-primary",
        "actions": {
          "default": "{color.text.primary}"
        },
        "$description": "Text primary color, dark theme."
      },
      "button": {
        "$value": "#0A1226",
        "source": "$btn-color",
        "actions": {
          "default": "{color.text.button}"
        },
        "$description": "Button text color, dark theme."
      }
    },
    "bg": {
      "info": {
        "$value": "{color.primary.light}",
        "$type": "color",
        "source": "$btn-info-hover-bg"
      },
      "light-overlay": {
        "$value": "#101B38",
        "source": "$bg-light-overlay",
        "actions": {
          "default": "{color.bg.light-overlay}"
        },
        "$description": "Light background overlay color, dark theme."
      },
      "hover": {
        "$value": "#18254A",
        "source": "$bg-hover",
        "actions": {
          "default": "{color.bg.hover}"
        },
        "$description": "Background hover color, dark theme."
      }
    },
    "body": {
      "bg": {
        "$value": "#0A1226",
        "source": "$body-bg",
        "actions": {
          "default": "{color.body.bg}"
        },
        "$description": "Body background, dark theme — Meridian midnight."
      },
      "base": {
        "$value": "{color.text.base}",
        "source": "$body-text",
        "$description": "Light text color, dark theme."
      }
    },
    "header": {
      "bg": {
        "$value": "#060B1A",
        "source": "$body-bg",
        "actions": {
          "default": "{color.body.bg}"
        },
        "$description": "Header background, dark theme — Meridian abyss."
      }
    },
    "accent": {
      "a": {
        "$value": "{color.primary.base}",
        "source": "$body-bg",
        "actions": {
          "default": "{color.body.bg}"
        },
        "$description": "Accent color, dark theme."
      }
    },
    "success": {
      "500": {
        "source": "$success-500",
        "actions": {
          "default": "{color.success.500}"
        },
        "$value": "#1F8A4C",
        "$description": "Success color of level 500."
      },
      "base": {
        "$value": "#45C48A",
        "source": "$success",
        "actions": {
          "default": "{color.success.base}"
        },
        "$description": "Basic success color, dark theme."
      }
    },
    "danger": {
      "base": {
        "$value": "#FF8E7A",
        "source": "$danger",
        "actions": {
          "default": "{color.danger.base}"
        },
        "$description": "Basic danger color, dark theme."
      }
    },
    "white": {
      "$value": "{color.body.bg}",
      "source": "$light-100",
      "actions": {
        "default": "{color.body.bg}"
      },
      "$description": "Header background color Profile page."
    },
    "gray": {
      "200": {
        "source": "$gray-200",
        "actions": {
          "default": "{color.gray.200}"
        },
        "$value": "#C2CDE8",
        "$description": "Gray color of level 200."
      },
      "500": {
        "source": "$gray-500",
        "actions": {
          "default": "{color.gray.500}"
        },
        "$value": "#8E9CC0",
        "$description": "Gray color of level 500."
      }
    },
    "toast": {
      "bg": {
        "$value": "{color.primary.light}"
      },
      "border": {
        "$value": "{color.text.base}"
      }
    },
    "border": {
      "$value": "{color.text.base}"
    },
    "bubble": {
      "bg": {
        "primary": {
          "$value": "{color.primary.base}"
        }
      }
    },
    "stepper": {
      "header": {
        "bg": {
          "line": {
            "$value": "{color.gray.500}"
          }
        }
      }
    },
    "dropzone": {
      "border": {
        "base": {
          "$value": "{color.primary.500}"
        }
      }
    },
    "black": {
      "$value": "#000"
    },
    "badge": {
      "bg": {
        "success": {
          "$value": "{color.success.500}"
        }
      }
    },
    "navbar": {
      "light": {
        "text": {
          "$value": "#B3BFDC",
          "$description": "Navbar link text (navbar-light) on the night page."
        },
        "hover": {
          "$value": "#F2F5FC",
          "$description": "Navbar link hover."
        },
        "active": {
          "$value": "#F2F5FC",
          "$description": "Active navbar link."
        },
        "disabled": {
          "$value": "rgba(233, 238, 250, 0.42)",
          "$description": "Disabled navbar link."
        }
      }
    },
    "nav-link": {
      "text": {
        "base": {
          "$value": "#B3BFDC",
          "$description": "Plain nav link text (e.g. the header Help link)."
        }
      }
    },
    "sqa": {
      "text-primary-500": {
        "$value": "#C2CDE8",
        "$description": "Readable value for text-primary-500 text. In dark the primary scale is surface navy."
      },
      "text-primary-600": {
        "$value": "#D5DCEE",
        "$description": "Readable value for text-primary-600 text."
      },
      "text-primary-700": {
        "$value": "#D5DCEE",
        "$description": "Readable value for text-primary-700 text."
      },
      "text-primary-800": {
        "$value": "#E9EEFA",
        "$description": "Readable value for text-primary-800 text."
      },
      "text-primary-900": {
        "$value": "#E9EEFA",
        "$description": "Readable value for text-primary-900 text."
      },
      "staffbar-bg": {
        "$value": "#18254A",
        "$description": "Staff bar (\"View this course as\") background."
      },
      "staffbar-text": {
        "$value": "#E9EEFA",
        "$description": "Staff bar text."
      },
      "staffbar-btn": {
        "$value": "#BCABFF",
        "$description": "Staff bar outline button text and border."
      },
      "staffbar-btn-hover-text": {
        "$value": "#0A1226",
        "$description": "Staff bar button text on hover fill."
      },
      "iris-1": {
        "$value": "#9F8BFF",
        "$description": "Iridescent line, first stop (violet)."
      },
      "iris-2": {
        "$value": "#C6D465",
        "$description": "Iridescent line, middle stop (olive)."
      },
      "iris-3": {
        "$value": "#45C48A",
        "$description": "Iridescent line, last stop (jade)."
      },
      "ring-fill": {
        "$value": "#A9BC3F",
        "$description": "Instrument ring fill, as on the certificate seal."
      },
      "ring-track": {
        "$value": "rgba(233, 238, 250, 0.14)",
        "$description": "Instrument ring track."
      },
      "ring-glow": {
        "$value": "rgba(169, 188, 63, 0.55)",
        "$description": "Ring glow (none in light mode)."
      },
      "surface-card": {
        "$value": "#1E2E5C",
        "$description": "Card surface: a clear step above the #0A1226 page (1.42:1), text stays >= 4.8:1."
      },
      "surface-inset": {
        "$value": "#16244B",
        "$description": "Recessed band inside a card (footers, table heads): darker than the card, lighter than the page."
      },
      "card-border": {
        "$value": "rgba(190, 205, 240, 0.30)",
        "$description": "Card hairline."
      },
      "card-shadow": {
        "$value": "rgba(0, 0, 0, 0.55)",
        "$description": "Card drop shadow color."
      },
      "card-edge": {
        "$value": "rgba(233, 238, 250, 0.08)",
        "$description": "Lit top edge inside a card (light source top-left)."
      }
    },
    "card": {
      "bg": {
        "base": {
          "$value": "{color.sqa.surface-card}",
          "$description": "Cards use the sqa card surface."
        }
      },
      "border": {
        "base": {
          "$value": "{color.sqa.card-border}",
          "$description": "Cards use the sqa hairline."
        }
      }
    }
  }
}

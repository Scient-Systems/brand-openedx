{
  "elevation": {
    "box-shadow": {
      "level": {
        "1": {
          "$value": "0px 2px 8px 0px rgba(2, 5, 16, 0.45), 0px 2px 4px 0px rgba(2, 5, 16, 0.35)"
        },
        "2": {
          "$value": "0px 4px 10px 0px rgba(2, 5, 16, 0.5), 0px 8px 16px 0px rgba(2, 5, 16, 0.4)"
        },
        "3": {
          "$value": "0px 8px 20px 0px rgba(2, 5, 16, 0.55), 0px 10px 20px 0px rgba(2, 5, 16, 0.45)"
        },
        "4": {
          "$value": "0px 8px 48px 0px rgba(2, 5, 16, 0.6), 0px 20px 40px 0px rgba(2, 5, 16, 0.5)"
        }
      },
      "base": {
        "$value": "{elevation.box-shadow.level.2}"
      },
      "sm": {
        "$value": "{elevation.box-shadow.level.1}"
      },
      "down": {
        "1": {
          "$value": "{elevation.box-shadow.level.1}"
        }
      },
      "lg": {
        "$value": "{elevation.box-shadow.level.3}"
      }
    }
  }
}

      },
      "primary": {
        "$value": "#5C6A8C",
        "source": "$text-color-primary",
        "$description": "Text primary color — ink-soft."
      }
    },
    "body": {
      "bg": {
        "$value": "#FBF5EA",
        "source": "$body-bg",
        "$description": "Body background — Night Quest paper."
      }
    }
  },
  "course": {
    "card": {
      "shadow": {
        "$value": "0px 1px 0px 0px rgba(29, 43, 80, 0.06), 0px 10px 30px 0px rgba(29, 43, 80, 0.1)",

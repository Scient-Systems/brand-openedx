      "100": {
        "source": "$primary-100",
        "modify": [
          {
            "type": "mix",
            "otherColor": "white",
            "amount": "0.94"
          }
        ],
        "actions": {
          "default": "{color.action.default.primary.100}"
        },
        "$value": "{color.primary.base}",
        "$description": "Primary color of level 100."
      },
      "base": {
        "$value": "#1D2B50",
        "source": "$primary",
        "$description": "Basic primary color — Night Quest ink (logo border navy)."
      },
      "light": {
        "$value": "#EEF2FA",
        "source": "$primary-light",
        "$description": "Light primary color — soft ink wash."
      }
    },
    "brand": {
      "base": {
        "$value": "#2B5FD0",
        "source": "$brand",
        "$description": "Brand color — deep quest-blue (AA-safe with white text)."
      }
    },
    "info": {
      "base": {
        "$value": "#2B5FD0",
        "source": "$info",
        "$description": "Info color — deep quest-blue."
      }
    },
    "text": {
      "base": {
        "$value": "#1D2B50",
        "source": "$text-color",
        "$description": "Text base color — ink."
      },
      "light": {
        "$value": "#5C6A8C",
        "source": "$text-color-light",
        "$description": "Text light color — ink-soft."
      },
      "footer": {
        "$value": "#8E9BBF",
        "source": "$light-dark",

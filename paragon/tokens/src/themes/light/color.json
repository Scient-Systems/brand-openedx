{
  "$type": "color",
  "color": {
    "primary": {
      "100": {
        "source": "$primary-100",
        "modify": [
          {
            "type": "mix",
            "otherColor": "white",
            "amount": "0.94"
          }
        ],
        "actions": {
          "default": "{color.action.default.primary.100}"
        },
        "$value": "{color.primary.base}",
        "$description": "Primary color of level 100."
      },
      "base": {
        "$value": "#101A33",
        "source": "$primary",
        "$description": "Basic primary color — Meridian ink (deep navy)."
      },
      "light": {
        "$value": "#ECEFDA",
        "source": "$primary-light",
        "$description": "Light primary color — soft ink wash."
      }
    },
    "brand": {
      "base": {
        "$value": "#66771D",
        "source": "$brand",
        "$description": "Brand color — Grove olive (AA-safe with white text)."
      }
    },
    "info": {
      "base": {
        "$value": "#5A41C4",
        "source": "$info",
        "$description": "Info color — Grove viola."
      }
    },
    "text": {
      "base": {
        "$value": "#101A33",
        "source": "$text-color",
        "$description": "Text base color — ink."
      },
      "light": {
        "$value": "#4F5E7E",
        "source": "$text-color-light",
        "$description": "Text light color — ink-soft."
      },
      "footer": {
        "$value": "#8E9CC0",
        "source": "$light-dark",
        "$description": "Footer text color — moon-dim (footer is night chrome)."
      },
      "primary": {
        "$value": "#4F5E7E",
        "source": "$text-color-primary",
        "$description": "Text primary color — ink-soft."
      }
    },
    "body": {
      "bg": {
        "$value": "#F2F4EA",
        "source": "$body-bg",
        "$description": "Body background — Meridian frost."
      }
    },
    "sqa": {
      "text-primary-500": {
        "$value": "#101A33",
        "$description": "Same as primary-500: light mode is unchanged."
      },
      "text-primary-600": {
        "$value": "#0E172E",
        "$description": "Same as primary-600."
      },
      "text-primary-700": {
        "$value": "#0D1529",
        "$description": "Same as primary-700."
      },
      "text-primary-800": {
        "$value": "#0C1426",
        "$description": "Same as primary-800."
      },
      "text-primary-900": {
        "$value": "#0B1224",
        "$description": "Same as primary-900."
      },
      "staffbar-bg": {
        "$value": "#101A33",
        "$description": "Staff bar background (light: navy, as before)."
      },
      "staffbar-text": {
        "$value": "#FFFFFF",
        "$description": "Staff bar text."
      },
      "staffbar-btn": {
        "$value": "#FFFFFF",
        "$description": "Staff bar outline button text and border."
      },
      "staffbar-btn-hover-text": {
        "$value": "#101A33",
        "$description": "Staff bar button text on hover fill."
      },
      "iris-1": {
        "$value": "#5A41C4",
        "$description": "Iridescent line, first stop (violet)."
      },
      "iris-2": {
        "$value": "#8CA12C",
        "$description": "Iridescent line, middle stop (olive)."
      },
      "iris-3": {
        "$value": "#1E8A55",
        "$description": "Iridescent line, last stop (jade)."
      },
      "ring-fill": {
        "$value": "#8CA12C",
        "$description": "Instrument ring fill, as on the certificate seal."
      },
      "ring-track": {
        "$value": "rgba(16, 26, 51, 0.10)",
        "$description": "Instrument ring track."
      },
      "ring-glow": {
        "$value": "rgba(140, 161, 44, 0)",
        "$description": "Ring glow (none in light mode)."
      },
      "surface-card": {
        "$value": "#FFFFFF",
        "$description": "Card surface on the frost page."
      },
      "surface-inset": {
        "$value": "#F5F6EE",
        "$description": "Recessed band inside a card (footers, table heads)."
      },
      "card-border": {
        "$value": "rgba(16, 26, 51, 0.14)",
        "$description": "Card hairline; white on frost is only 1.11:1, so the edge carries the card."
      },
      "card-shadow": {
        "$value": "rgba(16, 26, 51, 0.16)",
        "$description": "Card drop shadow color."
      },
      "card-edge": {
        "$value": "rgba(255, 255, 255, 0)",
        "$description": "No lit edge on day surfaces."
      },
      "answer-bg": {
        "$value": "#E2F6EC",
        "$description": "Endorsed-answer strip: jade tint."
      },
      "answer-ink": {
        "$value": "#156B39",
        "$description": "Endorsed-answer label and edge (deep jade, AA on the tint)."
      },
      "staff-ink": {
        "$value": "#5A41C4",
        "$description": "Staff / moderator names in discussions (viola, AA on white)."
      }
    },
    "card": {
      "bg": {
        "base": {
          "$value": "{color.sqa.surface-card}",
          "$description": "Cards use the sqa card surface."
        }
      },
      "border": {
        "base": {
          "$value": "{color.sqa.card-border}",
          "$description": "Cards use the sqa hairline."
        }
      }
    }
  },
  "course": {
    "card": {
      "shadow": {
        "$value": "0px 1px 2px 0px rgba(16, 26, 51, 0.04), 0px 16px 40px -12px rgba(16, 26, 51, 0.14)",
        "$type": "shadow",
        "source": "$course-card-shadow"
      }
    }
  }
}

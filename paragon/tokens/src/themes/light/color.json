{
  "$type": "color",
  "color": {
    "primary": {
      "100": {
        "source": "$primary-100",
        "modify": [
          {
            "type": "mix",
            "otherColor": "white",
            "amount": "0.94"
          }
        ],
        "actions": {
          "default": "{color.action.default.primary.100}"
        },
        "$value": "{color.primary.base}",
        "$description": "Primary color of level 100."
      },
      "base": {
        "$value": "#101A33",
        "source": "$primary",
        "$description": "Basic primary color — Meridian ink (deep navy)."
      },
      "light": {
        "$value": "#E8EFFC",
        "source": "$primary-light",
        "$description": "Light primary color — soft ink wash."
      }
    },
    "brand": {
      "base": {
        "$value": "#2B5FD0",
        "source": "$brand",
        "$description": "Brand color — Meridian sky blue (AA-safe with white text)."
      }
    },
    "info": {
      "base": {
        "$value": "#2B5FD0",
        "source": "$info",
        "$description": "Info color — Meridian sky blue."
      }
    },
    "text": {
      "base": {
        "$value": "#101A33",
        "source": "$text-color",
        "$description": "Text base color — ink."
      },
      "light": {
        "$value": "#4F5E7E",
        "source": "$text-color-light",
        "$description": "Text light color — ink-soft."
      },
      "footer": {
        "$value": "#8E9CC0",
        "source": "$light-dark",
        "$description": "Footer text color — moon-dim (footer is night chrome)."
      },
      "primary": {
        "$value": "#4F5E7E",
        "source": "$text-color-primary",
        "$description": "Text primary color — ink-soft."
      }
    },
    "body": {
      "bg": {
        "$value": "#F1F5FA",
        "source": "$body-bg",
        "$description": "Body background — Meridian frost."
      }
    }
  },
  "course": {
    "card": {
      "shadow": {
        "$value": "0px 1px 2px 0px rgba(16, 26, 51, 0.04), 0px 16px 40px -12px rgba(16, 26, 51, 0.14)",
        "$type": "shadow",
        "source": "$course-card-shadow"
      }
    }
  }
}
